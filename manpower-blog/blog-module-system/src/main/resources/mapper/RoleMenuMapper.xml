<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.manpowergroup.springboot.springboot3web.system.infrastructure.persistence.mapper.role.RoleMenuMapper">

    <!-- 共通の結果マッピング -->
    <resultMap id="BaseResultMap" type="com.manpowergroup.springboot.springboot3web.system.domain.model.role.RoleMenu">
        <id column="id" property="id" />
        <result column="role_id" property="roleId" />
        <result column="menu_id" property="menuId" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
        <result column="is_deleted" property="isDeleted" />
    </resultMap>

    <!-- 共通のカラム一覧 -->
    <sql id="Base_Column_List">
        id, role_id, menu_id, created_at, updated_at, is_deleted
    </sql>

    <select id="selectAllByRoleIdIncludeDeleted"
            resultMap="BaseResultMap">
        SELECT id, role_id, menu_id, created_at, updated_at, is_deleted
        FROM t_sys_role_menu
        WHERE role_id = #{roleId}
    </select>

    <update id="restoreMenus">
        UPDATE t_sys_role_menu
        SET is_deleted = 0, updated_at = #{now}
        WHERE role_id = #{roleId}
        AND is_deleted = 1
        AND menu_id IN
        <foreach collection="menuIds" item="mid" open="(" separator="," close=")">
            #{mid}
        </foreach>
    </update>

    <update id="logicalDeleteMenus">
        UPDATE t_sys_role_menu
        SET is_deleted = 1, updated_at = #{now}
        WHERE role_id = #{roleId}
        AND is_deleted = 0
        AND menu_id IN
        <foreach collection="menuIds" item="mid" open="(" separator="," close=")">
            #{mid}
        </foreach>
    </update>

</mapper>