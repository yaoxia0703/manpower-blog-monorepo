<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.manpowergroup.springboot.springboot3web.system.infrastructure.persistence.mapper.user.UserAccountMapper">

    <!-- 共通の結果マッピング -->
    <resultMap id="BaseResultMap"
               type="com.manpowergroup.springboot.springboot3web.system.domain.model.user.UserAccount">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="account_type" property="accountType"/>
        <result column="account_value" property="accountValue"/>
        <result column="password" property="password"/>
        <result column="verified" property="verified"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <!-- 共通のカラム一覧 -->
    <sql id="Base_Column_List">
        id
        , user_id, account_type, account_value, password, verified, status, created_at, updated_at, is_deleted
    </sql>
</mapper>
