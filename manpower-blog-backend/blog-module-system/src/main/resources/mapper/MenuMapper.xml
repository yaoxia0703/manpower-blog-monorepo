<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.manpowergroup.springboot.springboot3web.system.infrastructure.persistence.mapper.menu.MenuMapper">

    <!-- 共通の結果マッピング -->
    <resultMap id="BaseResultMap" type="com.manpowergroup.springboot.springboot3web.system.domain.model.menu.Menu">
        <id column="id" property="id" />
        <result column="parent_id" property="parentId" />
        <result column="name" property="name" />
        <result column="path" property="path" />
        <result column="component" property="component" />
        <result column="type" property="type" />
        <result column="sort" property="sort" />
        <result column="icon" property="icon" />
        <result column="status" property="status" />
        <result column="is_deleted" property="isDeleted" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <!-- 共通のカラム一覧 -->
    <sql id="Base_Column_List">
        m.id, m.parent_id, m.name, m.path, m.component, m.type, m.sort, m.icon, m.status, m.is_deleted, m.created_at, m.updated_at
    </sql>


    <!-- ユーザーIDに紐づくメニュー一覧取得 -->
    <select id="selectMenusByUserId"
            resultMap="BaseResultMap">
        SELECT m.id,
               m.parent_id,
               m.name,
               m.path,
               m.component,
               m.type,
               m.sort,
               m.icon,
               m.status,
               m.created_at,
               m.updated_at
        FROM t_sys_menu m
        WHERE m.status = 1
          AND m.is_deleted = 0
          AND m.type IN (1, 2)
          AND m.id IN (SELECT tsr.menu_id
                       FROM t_sys_role_menu tsr
                                JOIN t_sys_user_role tsur
                                     ON tsur.role_id = tsr.role_id
                       WHERE tsur.user_id = #{userId}
                         AND tsur.is_deleted = 0
                         AND tsr.is_deleted = 0)
        ORDER BY m.sort ASC, m.id ASC
    </select>

    <!-- 全子孫IDを再帰的に取得（WITH RECURSIVE） -->
    <select id="selectAllDescendantIds" resultType="java.lang.Long">
        WITH RECURSIVE sub AS (
            SELECT id FROM t_sys_menu
            WHERE parent_id = #{parentId} AND is_deleted = 0
            UNION ALL
            SELECT m.id FROM t_sys_menu m
                                 INNER JOIN sub ON m.parent_id = sub.id
            WHERE m.is_deleted = 0
        )
        SELECT id FROM sub
    </select>

    <!-- ステータス一括更新 -->
    <update id="updateStatusBatch">
        UPDATE t_sys_menu
        SET status = #{status}
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
